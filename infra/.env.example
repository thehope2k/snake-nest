# Production defaults -- copy to infra/.env on the VM and fill in real values.
# Never commit the real .env (see AGENTS.md on not committing secrets).

# Postgres password. Local dev uses "nest" -- never reuse that in production.
DB_PASSWORD=

# JWT signing secret. Generate with: openssl rand -base64 32
JWT_SECRET=

# LiveKit server SDK credentials. Generate with: docker run --rm livekit/livekit-server generate-keys
# The --dev fixed devkey/secret pair (used in local dev) must never run in production.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The browser connects to this directly -- it's NOT the backend-to-LiveKit
# address, the backend never makes a network call to LiveKit at all (it only
# signs/verifies JWTs). Must be the same public origin as SITE_ORIGIN below,
# with ws/wss instead of http/https -- Caddy proxies LiveKit's signaling at
# /rtc on that same origin (see Caddyfile), so this is not the internal
# `livekit` service hostname.
LIVEKIT_URL=wss://YOUR_VM_IP_OR_DOMAIN

# The origin the frontend is actually served from -- used for CORS. Must match
# SITE_ADDRESS below (with http/https scheme).
SITE_ORIGIN=http://YOUR_VM_IP

# Caddy's site address. Defaults to plain :80 (bare IP, no TLS) if unset.
# Once you have a domain pointed at this VM (A record), set it here and Caddy
# automatically provisions/renews a real HTTPS cert -- no other change needed.
# SITE_ADDRESS=nest.example.com

# Which image tag to deploy -- the CD workflow overrides this with the commit
# SHA on every deploy. Only needed manually if you're rolling back by hand.
IMAGE_TAG=latest

# owner/repo, used to build the GHCR image path (ghcr.io/<GITHUB_REPOSITORY>-backend).
GITHUB_REPOSITORY=thehope2k/snake-nest
